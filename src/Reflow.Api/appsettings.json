{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Reflow": ""
  },
  "Jwt": {
    "Key": "",
    "Issuer": "Reflow",
    "Audience": "Reflow",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "https://reflow.jasserlabs.dev/",
      "http://localhost:5173",
      "http://localhost:5174"
    ]
  },
  "WorkflowExecution": {
    "AllowPrivateNetwork": false
  },
  "RateLimiting": {
    "AuthPermitLimit": 5,
    "GeneralPermitLimit": 100,
    "WebhookPermitLimit": 30,
    "AiPermitLimit": 10
  },
  "Ai": {
    "Enabled": false,
    "BaseUrl": "https://api.groq.com/openai/v1",
    "Model": "llama-3.3-70b-versatile",
    "TimeoutSeconds": 30,
    "MaxRepairs": 2,
    "MaxOutputTokens": 1200,
    "MaxPromptChars": 2000,
    "MaxDraftNodes": 20
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  }
}
