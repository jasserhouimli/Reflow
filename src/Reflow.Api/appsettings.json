{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Google": {
      "ClientId": ""
    }
  },
  "ConnectionStrings": {
    "Reflow": ""
  },
  "Jwt": {
    "Key": "",
    "Issuer": "Reflow",
    "Audience": "Reflow",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "https://reflow.jasserlabs.dev",
      "http://localhost:5173",
      "http://localhost:5174"
    ]
  },
  "WorkflowExecution": {
    "AllowPrivateNetwork": false
  },
  "RateLimiting": {
    "AuthPermitLimit": 5,
    "GeneralPermitLimit": 100,
    "WebhookPermitLimit": 30,
    "AiPermitLimit": 10
  },
  "Ai": {
    "Enabled": true,
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/openai",
    "Model": "gemini-3.1-flash-lite",
    "ApiKey": "",
    "TimeoutSeconds": 60,
    "MaxTransientRetries": 1,
    "RetryDelayMilliseconds": 1000,
    "MaxRepairs": 2,
    "MaxOutputTokens": 2048,
    "MaxPromptChars": 2000,
    "MaxDraftNodes": 20
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  }
}
